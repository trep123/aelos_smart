{
  // ══════════════════════════════════════════════════════════════════
  // 机器人搬箱子任务全局配置文件
  // 所有可调参数集中在此，修改后重新运行即可生效，无需改 Python 代码
  // 若此文件缺失或格式错误，自动回退到内置默认值（与原始硬编码一致）
  // 单位约定: 距离=m(米), 时间=s(秒), 角度=°(度), 像素=px
  // ══════════════════════════════════════════════════════════════════
  "_version": "1.0",

  // ==================================================================
  // [system] 系统级配置
  // ==================================================================
  "system": {
    "ros_workspace_path": "/home/lemon/catkin_ws/src/aelos_smart_ros", // leju ROS 功能包的绝对路径
    "debug": false,                   // 调试模式: true=弹出 OpenCV 窗口显示检测结果
    "debug_display_window": "Box",
    "debug_display_wait_ms": 2000,
    "initial_mode": "full"            // 初始状态: "full"=完整流程, "return"=返程(从标签5 step2开始)
  },

  // ==================================================================
  // [camera] 摄像头与图像采集时序
  // ==================================================================
  "camera": {
    "topic": "/usb_cam_chest/image_raw",  // ROS 摄像头话题完整路径
    "image_fetch_interval_sec": 0.3,       // get_img() 每次循环获取图像后的等待间隔(s)
    "image_acquire_delay_sec": 0.05,       // 成功获取到图像后的短暂延迟(s)，让主线程有时间处理本帧
    "image_retry_delay_sec": 0.3           // 未获取到图像时的重试等待(s)
  },

  // ==================================================================
  // [image_processing] OpenCV 图像处理参数 —— 用于 find_box() 颜色分割
  // ==================================================================
  "image_processing": {
    "gaussian_blur": {
      "kernel_size": [3, 3]           // 高斯模糊核 (宽, 高): 必须为奇数, 越大降噪越强但细节越模糊
    },
    "erosion": {
      "iterations": 2                  // 腐蚀迭代次数: 值越大白色噪点消除越彻底, 但可能蚕食目标边缘
    },
    "dilation": {
      "kernel_size": [4, 4],          // 膨胀核 (宽, 高): 决定每次膨胀的像素扩展量
      "iterations": 2                  // 膨胀迭代次数: 值越大孔洞填充越充分, 目标区域越大
    },
    "min_contour_area": 200            // 最小轮廓面积(px): 面积<此值的检测结果被视为噪点忽略
  },

  // ==================================================================
  // [yolo] YOLO 模型配置 —— 替代 CV 进行方块识别 + 辅助远距离 ARTag 检测
  // ==================================================================
  "yolo": {
    "model_name": "best",                     // YOLO 模型名称（不含扩展名），文件放在 models/ 目录
    "backend": "ultralytics",                 // 推理后端: "ultralytics" 或 "onnx"
    "conf_threshold": 0.3,                    // 置信度阈值: < 此值的检测被忽略
    "box_class_map": {                        // config 颜色名 → YOLO 类别名映射
      "green": "green_square",
      "orange": "orange_square"
    },
    "artag_class": "artag",                   // ARTag 的 YOLO 类别名
    "tag_approach_scale": 0.5                 // YOLO 检测到 artag 时前进的比例(基于bbox大小)
  },

  // ==================================================================
  // [colors] HSV 颜色检测范围 —— OpenCV H=[0,180], S=[0,255], V=[0,255]
  // ==================================================================
  "colors": {
    "green": {                         // 绿色箱子 —— 最高优先级
      "hsv_lower": [38, 92, 91],      // HSV 下限 [H, S, V]: H=38(偏黄绿), S=92, V=91
      "hsv_upper": [87, 255, 255]     // HSV 上限 [H, S, V]: H=87(偏青绿), S=255, V=255
    },
    "orange": {                        // 橙色箱子 —— 绿色不存在时的备选
      "hsv_lower": [0, 107, 122],
      "hsv_upper": [19, 255, 255]
    }
  },

  // ==================================================================
  // [box_priority] 多颜色方块选择优先级
  // 列表中靠前的颜色优先。同一颜色内选面积最大（距离最近）的方块
  // ==================================================================
  "box_priority": {
    "_description": "颜色优先级列表: 靠前优先。同一颜色内选面积最大的(距离最近)。",
    "color_order": ["green", "orange"]
  },

  // ==================================================================
  // [box_detection] 箱子对正与抓取 —— goto_box() 的阈值和动作 ROS 名称
  // 图像分辨率约 640×480, 原点在左上角
  // ==================================================================
  "box_detection": {
    "thresholds": {
      "x_left_large": 275,             // x<275：箱子太偏左 → 大幅左移
      "x_left_small": 295,             // 275≤x<295：箱子略偏左 → 小幅左移
      "x_right_small": 345,            // 345<x≤365：箱子略偏右 → 小幅右移
      "x_right_large": 365,            // x>365：箱子太偏右 → 大幅右移
      "y_forward": 300,                // x已居中时，y<300：箱子偏上(距离远) → 前进
      "y_backward": 340                // x已居中时，y≥340：箱子偏下(距离近) → 后退
    },
    "no_coordinate_wait_sec": 0.3,     // 尚未检测到箱子坐标时的等待时间(s)
    "action_sleep_sec": 0.5,           // goto_box 中每次调整动作后的等待时间(s)
    "grab_tolerance": 0,               // 抓取容忍像素: 在移动阈值基础上向内收窄±N px
                                        //   0=与移动阈值一致; 10=更严格(310~330)
    "max_approach_steps": 5,           // 接近方块最大前进步数: 超出部分抓取后同方向退回
    "actions": {
      "left_large": "Left3move",       // 大幅度左移 —— ROS action 名称
      "left_small": "Left02move",      // 小幅度左移 (~1.5cm)
      "right_large": "Right3move",     // 大幅度右移
      "right_small": "Right02move",    // 小幅度右移 (~1.5cm)
      "forward": "FastForward1s",      // 前进一步 (~1秒步行距离)
      "backward": "Back1Run",          // 后退一步
      "grab_approach": "Forwalk01",    // 抓取前微调靠近
      "grab": "GrabCube",              // 夹取海绵块
      "lift": "LiftCubeUp"             // 抬升箱子
    }
  },

  // ==================================================================
  // [actions] 各动作函数执行后等待时间
  // 机器人每完成一个动作后需等待机械结构稳定，才能安全执行下一个动作
  // 空手动作为 0.5s；抱箱子动作为 1.0s（负载更大，稳定时间更长）
  // 键名 = Python 函数名，值 = 等待秒数
  // ==================================================================
  "actions": {
    "sleep_times": {
      // --- 放下/后退类 ---
      "Box_Down": 0.5,     // 放下箱子后等待
      "Box_Back": 0.5,     // 抱箱子后退
      "Box_Back1": 0.5,    // 抱箱子后退(变体)
      "Back2": 0.5,        // 空手后退两步
      "Back1": 0.5,        // 空手后退一步

      // --- 前进类 ---
      "go_fast": 0.5,      // 快速小步前进
      "go_fast1": 0.5,     // 快速前进一步 (~1s步行)
      "go_fast2": 0.5,     // 快速前进两步 (~2s步行)
      "go_fast3": 0.5,     // 快速前进三步 (~3s步行)
      "box_go": 0.5,       // 抱箱子小步前进
      "box_go1": 1.0,      // 抱箱子前进一步 —— 负载大，等待 1.0s
      "box_go2": 1.0,      // 抱箱子前进两步
      "box_go3": 1.0,      // 抱箱子前进三步

      // --- 侧移类 ---
      "L_move1": 0.5,      // 空手左侧移(~1.5cm)
      "L_move2": 0.5,      // 空手左侧移大步
      "BoxL_move1": 1.0,   // 抱箱子左侧移小步
      "BoxL_move2": 1.0,   // 抱箱子左侧移大步
      "R_move1": 0.5,      // 空手右侧移(~1.5cm)
      "R_move2": 0.5,      // 空手右侧移大步
      "BoxR_move1": 1.0,   // 抱箱子右侧移小步
      "BoxR_move2": 1.0,   // 抱箱子右侧移大步

      // --- 转向类 ---
      "L_turn1": 0.5,      // 空手左转小角度(~7°)
      "L_turn2": 0.5,      // 空手左转大角度(~1s持续转)
      "BoxL_turn1": 1.0,   // 抱箱子左转小角度
      "BoxL_turn2": 1.0,   // 抱箱子左转大角度
      "R_turn1": 0.5,      // 空手右转小角度(~7°)
      "R_turn2": 0.5,      // 空手右转大角度(~1s持续转)
      "BoxR_turn1": 1.0,   // 抱箱子右转小角度
      "BoxR_turn2": 1.0    // 抱箱子右转大角度
    }
  },

  // ==================================================================
  // [tag_alignment] AR 标签对正 —— turn_to_tag() 多级逼近算法全部参数
  // 10 级决策树，优先级从高到低，每级一个区间带，逐级缩小逼近
  // ==================================================================
  "tag_alignment": {
    "defaults": {
      "x_threshold": 0.03,       // x方向最终容忍误差(m): 距离<3cm视为对正完成
      "y_threshold": 0.02,       // y方向最终容忍误差(m): 左右偏差<2cm视为对正完成
      "theta_threshold": 10       // 角度最终容忍误差(°): 偏角<5°视为对正完成
    },
    "offsets": {
      "_description": "以下偏移量与上述阈值组合，形成 10 级决策树的各级触发区间带",

      "back_threshold": 0.03,       // Level1: 后退触发偏移。x_error < (x_threshold - 此值) → 后退
      "theta_hard_limit": 35,       // Level2: 大角度转向硬上限。|theta_error ± theta_threshold| > 此值 → 大幅转向
      "coarse_y_offset": 0.05,      // Level3: 粗调平移触发。|y_error| > (y_threshold + 此值) → 大步平移
      "fast_approach_offset": 0.2,  // Level4: 快速逼近触发。x_error > (x_threshold + 此值) → 大步前进
      "slow_approach_offset": 0.12, // Level7: 慢速逼近触发。x_error > (x_threshold + 此值) → 中步前进
      "fine_approach_offset": 0.06  // Level8: 精调逼近触发。x_error > (x_threshold + 此值) → 小步前进
    },
    "yaw_offset_deg": 90            // ARTag 坐标系正方向与机器人正方向的固定偏角(°)
  },

  // ==================================================================
  // [ar_tags] AR 标签检测 —— TagConverter 类配置
  // ==================================================================
  "ar_tags": {
    "topic": "/chest/ar_pose_marker",  // AR 标签检测结果 ROS 话题
    "min_id_threshold": 15,             // 标签 ID 哨兵值（必须 > 所有实际标签 ID），扫描后仍为此值 = 未检测到
    "min_valid_id": 1,                  // 最小有效标签 ID: ID<此值的标签被忽略（防止标签0等干扰）
    "scan_iterations": 20,             // 帧累积次数: 越大检测越可靠但延迟越高（20次×0.01s=0.2s总延迟）
    "scan_delay_sec": 0.01             // 每次帧采样间隔(s)
  },

  // ==================================================================
  // [timing] 全局时序 —— 初始化延迟与主循环速率
  // ==================================================================
  "timing": {
    "init_node_delay_sec": 0.5,       // ROS 节点初始化后等待(s): 确保订阅建立
    "startup_wait_sec": 5.0,          // 启动后等待(s): 确保摄像头驱动和传感器全部就绪
    "camera_poll_interval_sec": 0.1,  // 摄像头就绪轮询间隔(s): 等待首帧图像
    "box_loop_delay_sec": 0.1,        // 箱子检测循环间隔(s): 控制抓取阶段的循环速率
    "main_loop_delay_sec": 0.1,       // 主循环间隔(s): 控制整体 CPU 占用率
    "goto_box_wait_sec": 0.3          // goto_box() 中无坐标时的等待(s)
  },

  // ==================================================================
  // [initial_action] 启动初始动作 —— 摄像头就绪后执行一次
  // ==================================================================
  "initial_action": {
    "action": "go_fast2",  // 动作函数名: 前进两步进入场地
    "repeat": 2            // 重复次数
  },

  // ==================================================================
  // [box_transition] 搬箱子过渡动作 —— ID 从 0 切换到 1 时执行
  // ==================================================================
  "box_transition": {
    "step1": [                           // step1(去程)抓完箱子后的过渡:
      {"action": "box_go2", "repeat": 2}, // 抱箱子前进两步 → 远离抓取点
      {"action": "BoxR_turn2", "repeat": 1} // 抱箱子右转 → 朝向标签 1 方向
    ],
    "step2": [                           // step2(返程)抓完箱子后的过渡:
      {"action": "BoxR_turn2", "repeat": 3} // 抱箱子右转三次 → 调头转向返程方向
    ]
  },

  // ==================================================================
  // [no_marker_fallback] 未检测到 AR 标签时的兜底动作
  // 根据当前 (ID, level, step) 状态匹配不同兜底行为
  // ==================================================================
  "no_marker_fallback": {
    "id1_end_box":       {"action": "BoxR_turn2", "repeat": 1},  // 刚抓完箱(ID=1,end_box) → 抱箱右转找标签
    "id1_4_step1_early": {"action": "Box_Back",   "repeat": 1},  // 去程中(ID=1~4,step1) → 抱箱后退重新搜索
    "id5_step2_start":   {"action": "R_turn2",    "repeat": 1},  // 返程开始(ID=5,step2,start_moving) → 空手右转找标签
    "id5_7_step2_late":  {"action": "Back2",      "repeat": 1}   // 返程中后段(ID=5~7,step2) → 空手后退重新搜索
  },

  // ==================================================================
  // [reset_sequence] 抓完方块后的复位动作（按step区分抱箱/空手）
  // 在 box_transition 之后、进入标签导航之前执行
  // ==================================================================
  "reset_sequence_step1": [
  ],
  "reset_sequence_step2": [
  ],

  // ==================================================================
  // [waypoints] 全部路径点定义 —— 导航的核心数据
  //
  // 完整路径: step1(去程抱箱): 1→2→3→4→5   step2(返程空手): 5→6→7→1(回到起点)
  //
  // 每个路径点字段:
  //   tag_id            目标 AR 标签编号
  //   x_offset          x方向(前后)目标偏移(m) —— 正=停在标签前方
  //   y_offset          y方向(左右)目标偏移(m) —— 正=停在标签左侧, 负=右侧
  //   theta_offset      角度目标偏移(°) —— 0=同向对齐, 180=反向对齐
  //   x_threshold       [可选] x方向容忍误差(m): 覆盖全局 tag_alignment.defaults.x_threshold
  //   y_threshold       [可选] y方向容忍误差(m): 覆盖全局 tag_alignment.defaults.y_threshold
  //   theta_threshold       [可选] 角度容忍误差(°): 对称值，等同于同时设 left/right
  //   theta_threshold_left  [可选] 正角度(左偏)容忍(°): theta_error>此值触发左转, 默认=theta_threshold
  //   theta_threshold_right [可选] 负角度(右偏)容忍(°): theta_error<-此值触发右转, 默认=theta_threshold
  //                          可不对称配置, 如 left=30 right=20 → 左偏30°内不管, 右偏20°以上才调
  //   set_level         [可选] 到达后设置 level 状态
  //   transition_to_step [可选] 到达后切换 step 值 (如 1→2)
  //   reset_mission     [可选] true=重置任务回到抓箱子阶段
  //   on_aligned        对正成功后的过渡动作序列 [{"action":"函数名","repeat":次数}, ...]
  //   on_other_tag      看到此标签但 ID 不匹配时的搜索动作序列
  // ==================================================================
  "waypoints": {
    // ==================== 第一步: 去程 抱箱子沿路径前进 ====================
    "step1": [
      {
        "tag_id": 1,                    // 目标: 标签 1
        "x_offset": 0.08,               // 停在标签前方 8cm 处
        "y_offset": 0.0,                // 左右居中对齐
        "theta_offset": 2,              // 偏角补偿 0°
        "theta_threshold": 15,
        "set_level": "start_moving",    // 到达后设 level="start_moving"，进入导航状态
        "on_aligned": [                 // 对正成功 → 过渡到标签 2:
          {"action": "box_go2", "repeat": 3}  // 抱箱子前进两步
        ],
        "on_other_tag": [              // 看到标签 1 但 ID 不对 → 朝它靠近:
          {"action": "box_go2", "repeat": 2}  // 抱箱子前进两步
        ]
      },
      {
        "tag_id": 2,                    // 目标: 标签 2
        "x_offset": 0.08,               // 停在标签前方 8cm 处
        "y_offset": 0.0,                // 左右居中对齐
        "theta_offset": 0,              // 无偏角补偿
        "on_aligned": [                 // 对正成功 → 过渡到标签 3:
          {"action": "BoxR_move2", "repeat": 3}  // 抱箱子右移三步
        ],
        "on_other_tag": [              // 搜索: 朝标签 2 靠近
          {"action": "BoxR_move2", "repeat": 1}  // 抱箱子右移一步
        ]
      },
      {
        "tag_id": 3,                    // 目标: 标签 3
        "x_offset": 0.09,               // 停在标签前方 9cm 处
        "y_offset": 0.08,               // 停在标签左侧 8cm 处（与标签保持侧向距离）
        "theta_offset": 0.0,
        "on_aligned": [                 // 对正成功 → 过渡到标签 4（多段组合移动）:
          {"action": "BoxR_move2", "repeat": 2},  // 右移一步
          {"action": "BoxR_move1", "repeat": 1},  // 右移小步
          {"action": "box_go2", "repeat": 3},     // 前进两步
          {"action": "box_go1", "repeat": 1}      // 前进一步
        ],
        "on_other_tag": [
          {"action": "BoxR_move2", "repeat": 1}
        ]
      },
      {
        "tag_id": 4,                    // 目标: 标签 4
        "x_offset": 0.08,
        "y_offset": -0.1,               // 停在标签右侧 10cm 处（负=右侧）
        "theta_offset": 0,
        "on_aligned": [                 // 对正成功 → 过渡到标签 5:
          {"action": "BoxL_move2", "repeat": 3}  // 抱箱子左移三步（朝标签 5 方向）
        ],
        "on_other_tag": [
          {"action": "BoxL_move2", "repeat": 1}
        ]
      },
      {
        "tag_id": 5,                    // 目标: 标签 5（大本营/终点）
        "x_offset": 0.09,
        "y_offset": 0.0,
        "theta_offset": 0.0,
        "theta_threshold_left": 30,        // 左偏容忍30°（正角度方向放宽）
        "theta_threshold_right": 20,       // 右偏容忍20°（负角度方向收紧）
        "on_aligned": [                 // 到达大本营! 执行放下箱子序列:
          {"action": "box_go2", "repeat": 4},    // 前进三步（深入大本营区域）
          {"action": "Box_Down", "repeat": 1},   // 放下海绵块
          {"action": "R_turn2", "repeat": 4}     // 右转三次（调头准备返程）
        ],
        "transition_to_step": 2         // 切换到 step=2（返程模式）
      }
    ],

    // ==================== 第二步: 返程 空手沿路径返回起点 ====================
    "step2": [
      {
        "tag_id": 5,                    // 目标: 标签 5（反向对正）
        "x_offset": 0.08,
        "y_offset": 0.0,
        "theta_offset": 180,            // 180°反向对齐 —— 机器人面朝来时的反方向
        "theta_threshold": 15,          // 反向标签放宽角度容忍度(全局默认10°→此标签15°)
        "set_level": "reverse_moving",  // 到达后设 level="reverse_moving"，进入返程导航
        "on_aligned": [                 // 对正成功 → 过渡到标签 6:
          {"action": "go_fast2", "repeat": 1},  // 空手前进两步
          {"action": "go_fast1", "repeat": 2}   // 空手前进两步(分两次)
        ]
      },
      {
        "tag_id": 6,                    // 目标: 标签 6
        "x_offset": 0.05,               // 停在标签前方仅 5cm（更精确的逼近）
        "y_offset": -0.1,               // 停在标签右侧 10cm
        "theta_offset": 0,
        "on_aligned": [                 // 对正成功 → 过渡到标签 7:
          {"action": "L_move2", "repeat": 4},    // 空手左移四步
          {"action": "go_fast2", "repeat": 3},   // 空手前进四步(分两次)
          {"action": "go_fast1", "repeat": 1}    // 空手前进一步
        ]
      },
      {
        "tag_id": 7,                    // 目标: 标签 7
        "x_offset": 0.06,               // 停在标签前方 6cm
        "y_offset": 0.10,               // 停在标签左侧 10cm
        "theta_offset": 0,
        "on_aligned": [                 // 对正成功 → 过渡到标签 1（起点）:
          {"action": "R_move2", "repeat": 6}  // 空手右移五步（朝起点方向）
        ]
      },
      {
        "tag_id": 1,                    // 目标: 标签 1（起点，反向对正）
        "x_offset": 0.1,                // 停在标签前方 10cm
        "y_offset": 0.0,
        "theta_offset": 180,            // 180°反向对齐 —— 回到起点但面朝来时的反方向
        "theta_threshold": 15,          // 反向标签放宽角度容忍度(全局默认10°→此标签15°)
        "match_any": true,              // ★ 不检查 ID: step2 中只要看到标签1就触发（原始逻辑中此路径点不判断 ID）
        "reset_mission": true,          // ★ 任务重置: ID→0, level→"start_box", 重新抓箱子
        "on_aligned": [
          {"action": "go_fast2", "repeat": 3}  // 空手前进四步（进入下一个循环的启动位置）
        ]
      }
    ]
  }
}
